# Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:tiger@localhost:5432/ecosense

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
APP_NAME=EcoSense API
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# AI Classification Configuration
CLASSIFICATION_MODEL_PATH=ai/models/classifier_v1.onnx
CLASSIFICATION_MODEL_VERSION=v1.0-mock
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70

# AI Prediction Configuration
PREDICTION_HORIZON_MINUTES=120
MIN_PREDICTION_READINGS=3
PREDICTION_MODEL_VERSION=baseline-v1

# Campus Timezone Configuration
CAMPUS_TIMEZONE=Asia/Kolkata

# Firebase Cloud Messaging (FCM) Web Push Configuration
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=ecosense-98229
# Path to service account JSON (keep outside publicly served directories, e.g., secrets/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/serviceAccountKey.json
# Public deployment URLs (used in push notification deep-links and CORS)
PUBLIC_FRONTEND_URL=https://www.ecosenseapp.site
PUBLIC_BACKEND_URL=https://api.ecosenseapp.site

# (Legacy / Deprecated: SMS_HORIZON_* variables are no longer used by EcoSense)

# Optional Development Seed Credentials
DEV_ADMIN_EMAIL=admin@dbit.in
DEV_ADMIN_PASSWORD=adminpassword
DEV_STUDENT_EMAIL=student@dbit.in
DEV_STUDENT_PASSWORD=studentpassword
DEV_COLLECTOR_EMAIL=collector@dbit.in
DEV_COLLECTOR_PASSWORD=collectorpassword
DEV_STAFF_EMAIL=staff@dbit.in
DEV_STAFF_PASSWORD=staffpassword

